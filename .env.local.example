# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local wird von Git ignoriert (siehe .gitignore) und darf niemals
# committet werden.

# --- Supabase (Projekt-Einstellungen -> API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUR serverseitig verwenden (lib/supabase/admin.ts). Niemals mit dem
# NEXT_PUBLIC_-Präfix versehen, sonst landet der Key im Client-Bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Claude API (erst ab Phase 9/10/12 benötigt) ------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
